{
  "name": "serpent-sorcery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "playtest": "node scripts/playtest.mjs",
    "offline": "vite build && node scripts/offline-check.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop": "vite build && npm --prefix desktop start",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:package": "vite build && npm --prefix desktop run package",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json",
    "desktop:check": "node scripts/desktop-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
